generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Inquiry {
  id          String   @id @default(cuid())
  serviceType String
  destination String?
  name        String
  email       String
  phone       String?
  budget      String?
  departDate  String?
  returnDate  String?
  adults      Int      @default(2)
  children    Int      @default(0)
  details     String?
  createdAt   DateTime @default(now())
  status      String   @default("Pending")
}

model HeroConfig {
  id          String   @id @default(cuid())
  title       String   @default("The World")
  subtitle    String   @default("Embark on a Journey That's Uniquely Yours")
  description String   @default("Curated travel itineraries, authentic cultural experiences, and tailor-made holidays across the globe.")
  images      String[]
  updatedAt   DateTime @updatedAt
}

model TourPackage {
  id        String   @id @default(cuid())
  days      Int
  title     String
  icon      String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Destination {
  id        String   @id @default(cuid())
  name      String
  location  String
  image     String
  rating    Float    @default(5.0)
  price     String   @default("Custom")
  tag       String   @default("Luxury")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  excerpt   String
  category  String
  author    String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
